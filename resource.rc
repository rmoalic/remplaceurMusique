    IDS_PRE4_DSC        "Max 150 kbps, 240p, 96 kbps audio (mono)"

    IDS_WAVE_LOAD       "Chargez un fichier audio pour voir la forme d'onde"
    IDS_WAVE_UNAVAIL    "Forme d'onde non disponible"
    IDS_WAVE_ANALYZING  "Analyse en cours…"

    // Erreurs d'encodage
    IDS_ENC_ERR_VIDEO_OPEN_FAILED               "Impossible d'ouvrir la vidéo source."
    IDS_ENC_ERR_VIDEO_STREAM_SELECT_FAILED      "Impossible de sélectionner le flux vidéo source."
    IDS_ENC_ERR_VIDEO_DECODE_FAILED             "Impossible de décoder la vidéo."
    IDS_ENC_ERR_VIDEO_TYPE_READ_FAILED          "Erreur lecture type vidéo."
    IDS_ENC_ERR_VIDEO_DIMENSIONS_INVALID        "Dimensions vidéo source invalides."
