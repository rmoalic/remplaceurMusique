    IDS_ENC_ERR_AUDIO_STREAM_SELECT_FAILED      "Impossible de sélectionner le flux audio source."
    IDS_ENC_ERR_AUDIO_FORMAT_FAILED             "Impossible de décoder l'audio au format PCM demandé."
    IDS_ENC_ERR_AUDIO_SEEK_FAILED               "Impossible de positionner l'audio source."
    IDS_ENC_ERR_AUDIO_TYPE_READ_FAILED          "Impossible de lire le format PCM audio."
    IDS_ENC_ERR_OUTPUT_CREATE_FAILED            "Impossible de créer le fichier de sortie."
    IDS_ENC_ERR_VIDEO_STREAM_ADD_FAILED         "Erreur ajout flux H264."
    IDS_ENC_ERR_VIDEO_STREAM_TYPE_INCOMPATIBLE  "Type vidéo incompatible avec l'encodeur H264."
    IDS_ENC_ERR_AUDIO_STREAM_ADD_FAILED         "Erreur ajout flux AAC."
    IDS_ENC_ERR_AUDIO_STREAM_CONFIG_FAILED      "Erreur configuration AAC. (Windows 7+)"
    IDS_ENC_ERR_VIDEO_SEEK_FAILED               "Impossible de positionner la vidéo source."
    IDS_ENC_ERR_SINK_WRITER_BEGIN_FAILED        "Erreur démarrage écriture MP4."
    IDS_ENC_ERR_SINK_WRITER_FINALIZE_FAILED     "Impossible de finaliser le fichier MP4."
    IDS_ENC_ERR_VIDEO_READ_FAILED               "Erreur pendant la lecture de la vidéo."
    IDS_ENC_ERR_VIDEO_WRITE_FAILED              "Erreur pendant l'écriture de la vidéo."
    IDS_ENC_ERR_AUDIO_READ_FAILED               "Erreur pendant la lecture de l'audio."
    IDS_ENC_ERR_AUDIO_WRITE_FAILED              "Erreur pendant l'écriture de l'audio."
    IDS_ENC_ERR_AUDIO_SILENCE_WRITE_FAILED      "Erreur pendant l'écriture du silence audio."
    IDS_ENC_ERR_AUDIO_LOOP_RESTART_FAILED       "Impossible de relancer l'audio source."
    IDS_ENC_ERR_CANCELLED                       "Annulé."
    IDS_ENC_ERR_UNKNOWN                         "Erreur inconnue lors de l'encodage."
