LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

STRINGTABLE
BEGIN
    IDS_APP_TITLE       "Remplaceur de Musique Vidéo"
    IDS_SUBTITLE        "Remplacez le son d'une vidéo par une piste musicale — sans logiciel tiers."
    IDS_DROP_HINT       "Saisissez un chemin, glissez un fichier, ou cliquez Parcourir."

    IDS_SEC_VIDEO       "1. Fichier vidéo"
    IDS_SEC_MUSIC       "2. Fichier musical"
    IDS_SEC_SHORT       "3. Si la musique est plus courte que la vidéo :"
    IDS_SEC_QUALITY     "4. Qualité / taille du fichier :"

    IDS_BROWSE          "Parcourir…"
    IDS_CROP_START      "  Début :"
    IDS_CROP_END        "  Fin :"
    IDS_CROP_HINT       "(vide = vidéo entière)"
    IDS_MUS_WAVE_HINT   "← rouge/vert sur la forme d'onde"
    IDS_VOLUME          "  Volume :"
    IDS_BTN_GO          "✨  Remplacer l'audio"

    IDS_LOOP            "🔁  Répéter depuis le début choisi"
    IDS_SILENCE         "🔇  Silence jusqu'à la fin de la vidéo"

    IDS_READY           "Prêt."
    IDS_ENCODING        "Encodage en cours… %d %%"
    IDS_DONE_STATUS     "✅  Terminé ! Votre vidéo est prête."
    IDS_ERR_STATUS      "❌  Erreur lors de l'encodage."
    IDS_DONE_MSG        "Votre vidéo est prête !"
    IDS_DONE_TITLE      "C'est fait !"
    IDS_ERR_TITLE       "Erreur"

    IDS_ERR_NO_VIDEO    "Veuillez choisir un fichier vidéo valide."
    IDS_ERR_NO_AUDIO    "Veuillez choisir un fichier musical valide."
    IDS_ERR_BAD_AUD_START "Heure de début musical invalide (format hh:mm:ss)."
    IDS_ERR_BAD_VID_START "Heure de début vidéo invalide (format hh:mm:ss)."
    IDS_ERR_VID_ORDER   "Le début de la vidéo doit être avant la fin."
    IDS_ERR_AUD_ORDER   "Le début de la musique doit être avant la fin."
    IDS_ERR_TITLE_VAL   "Paramètre invalide"

    IDS_DURATION_FMT    "  Durée : %s   (%s)"
    IDS_DUR_UNAVAIL     "  (durée non disponible)"

    IDS_PRE0_LBL        "Qualité originale"
    IDS_PRE0_DSC        "Bitrate identique à la source — taille similaire"
    IDS_PRE1_LBL        "Facebook / Instagram"
    IDS_PRE1_DSC        "Max 5 Mbps, 1080p, 128 kbps audio"
    IDS_PRE2_LBL        "Compact (partage Web)"
    IDS_PRE2_DSC        "Max 2 Mbps, 720p, 128 kbps audio"
    IDS_PRE3_LBL        "Pièce jointe e-mail"
    IDS_PRE3_DSC        "Max 400 kbps, 480p, 96 kbps audio (mono)"
    IDS_PRE4_LBL        "MMS / SMS"
    IDS_PRE4_DSC        "Max 150 kbps, 240p, 96 kbps audio (mono)"

    IDS_WAVE_LOAD       "Chargez un fichier audio pour voir la forme d'onde"
    IDS_WAVE_UNAVAIL    "Forme d'onde non disponible"
    IDS_WAVE_ANALYZING  "Analyse en cours…"
END

